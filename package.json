    "react-window": "^2.2.7",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "zustand": "^5.0.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gujismart.app",
    "productName": "文献管理",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GujiSmart-${version}-Setup-${arch}.${ext}",
      "include": "build/installer.nsh",
      "language": "2052"
    },
    "portable": {
      "artifactName": "GujiSmart-${version}-Portable-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/vendor/**/*",
      "!node_modules/**/*.map",
      "!node_modules/better-sqlite3/build/Release/*.exp",
      "!node_modules/better-sqlite3/build/Release/*.iobj",
      "!node_modules/better-sqlite3/build/Release/*.ipdb",
      "!node_modules/better-sqlite3/build/Release/*.lib",
      "!node_modules/better-sqlite3/build/Release/*.pdb",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/better-sqlite3/build/deps/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/pdf-lib/dist/**/*",
      "!node_modules/pdf-lib/es/**/*",
      "!node_modules/pdf-lib/src/**/*",
      "!node_modules/pdf-lib/ts3.4/**/*",
      "!node_modules/pdf-lib/yarn.lock",
      "!node_modules/pdfjs-dist/build/**/*",
      "!node_modules/pdfjs-dist/legacy/web/**/*",
      "!node_modules/pdfjs-dist/types/**/*",
      "!node_modules/pdfjs-dist/web/**/*",
      "!node_modules/@pdf-lib/fontkit/dist/fontkit.es.js",
      "!node_modules/@pdf-lib/fontkit/dist/fontkit.es.min.js",
      "!node_modules/@pdf-lib/fontkit/dist/fontkit.umd.min.js",
      "!node_modules/@pdf-lib/fontkit/es/**/*",
      "!node_modules/@pdf-lib/fontkit/lib/**/*",
      "!node_modules/opencc-js/dist/esm/**/*",
      "!node_modules/opencc-js/dist/esm-lib/**/*",
      "!node_modules/opencc-js/dist/umd/cn2t.js",
      "!node_modules/opencc-js/dist/umd/t2cn.js",
      "!node_modules/opencc-js/types/**/*"
    ],
    "extraResources": [
      {
        "from": "out/mcp",
        "to": "mcp",
        "filter": [
          "mcp-host.cjs"
        ]
      },
      {
        "from": "resources/vendor",
        "to": "vendor"
      },
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "licenses/NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "tmp/package-metadata",
        "to": "release-metadata",
        "filter": [
          "sbom.spdx.json",
          "vendor-manifest.json"
        ]
      }
    ]
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.23",
    "tar": "^7.5.22"
  }
}
