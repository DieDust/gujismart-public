    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.24.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "epubjs": "^0.3.93",
    "marked": "^18.0.3",
    "nanoid": "^5.1.0",
    "playwright": "^1.59.1",
